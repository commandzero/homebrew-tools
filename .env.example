# Native x86_64 Linux host with SSH key or certificate authentication and Podman.
LINUX_X86_64_SSH_HOST=linux-amd64-builder

# Native arm64 Linux host with SSH key or certificate authentication and Podman.
LINUX_ARM64_SSH_HOST=linux-arm64-builder

# URL Homebrew writes into generated bottle blocks.
BOTTLE_ROOT_URL=https://github.com/commandzero/homebrew-tools/releases/download/bottles

# Tap name used for Homebrew-qualified formula names.
HOMEBREW_TAP=commandzero/tools

# Multi-architecture Homebrew image used on the Linux hosts.
LINUX_PODMAN_IMAGE=ghcr.io/homebrew/brew:main

# Optional space-separated formula list. Defaults to "tq".
BOTTLE_FORMULAE="tq"
